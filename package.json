{
  "name": "adsb-skyvista",
  "version": "1.0.0",
  "description": "Display aircraft detected by your local dump1090 receiver directly in Home Assistant.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
